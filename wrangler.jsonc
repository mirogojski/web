{
  // Cloudflare Worker with static assets. See worker/index.ts.
  // "name" must match the Worker's name in the Cloudflare dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Builds dist/ before every deploy and dev run, so the deploy does not rely
  // on a build command set in the Cloudflare dashboard.
  "build": {
    "command": "npm run build",
    "watch_dir": "./src"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Not secret. RESEND_API_KEY and TURNSTILE_SECRET_KEY are secrets: set them
  // with `wrangler secret put` or in the dashboard, and locally in .dev.vars
  // (gitignored).
  "vars": {
    "CONTACT_TO": "nikola@mirogoj.com",
    "CONTACT_FROM": "mirogoj.com <web@mirogoj.com>"
  },
  // Caps contact form submissions per IP. See isRateLimited().
  "kv_namespaces": [
    {
      "binding": "CONTACT_RATELIMIT",
      "id": "3cc9f31970834c76a4c6b29b68b72d77"
    }
  ]
}
