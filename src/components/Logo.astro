---
/**
 * Logo Component
 *
 * Mirogoj brand logo: three arcade arches beside a "Mirogoj" wordmark, drawn
 * after the arcade motif in the Privredna banka Zagreb mark but without its
 * enclosing box and without the rule above the arches.
 *
 * Both parts are a single inline SVG so the arches and the letters cannot drift
 * out of alignment, and both follow the theme through currentColor - no separate
 * light and dark files to keep in step.
 *
 * The wordmark is stored as path outlines rather than live text. Two reasons:
 *
 * 1. Gilroy ExtraBold, the requested face, is a commercial font that cannot be
 *    self-hosted without a licence. Montserrat ExtraBold stands in: a geometric
 *    sans of the same lineage, SIL OFL licensed. The letterforms differ in
 *    detail - Gilroy has a single-storey 'g', this has a double-storey one - but
 *    the weight and geometric character match.
 * 2. Outlines need no webfont download and render identically everywhere, which
 *    matters for a mark that sits in the header of every page.
 *
 * Outlines were generated from Montserrat-ExtraBold.otf with fontTools, scaled
 * to a 100-unit cap height, kerned from the font's own GPOS table (r+o = -7) and
 * tracked -8/1000em. The viewBox runs 0 0 730 144: cap top at y=0, baseline at
 * y=114.86, descenders of g and j reaching y=143.86.
 *
 * Regenerating the wordmark is a manual step - there is no build script - so
 * treat the path data as a fixed asset.
 *
 * @example
 * ```astro
 * <Logo />
 * <Logo showText={false} />
 * <Logo size="lg" />
 * ```
 */
interface Props {
  /** Show the wordmark next to the arches */
  showText?: boolean;
  /** Size variant */
  size?: 'sm' | 'md' | 'lg';
  /** Additional CSS classes */
  class?: string;
}

const { showText = true, size = 'md', class: className = '' } = Astro.props;

/**
 * Heights are set rather than widths, so the arches keep the same optical
 * weight next to the header navigation whether or not the wordmark shows.
 */
const fullSize = {
  sm: 'h-5',
  md: 'h-6',
  lg: 'h-8',
};

const markOnlySize = {
  sm: 'h-4',
  md: 'h-5',
  lg: 'h-7',
};

/** Three arches: springing line at y=34.36, baseline at y=114.86. */
const ARCHES =
  'M4.5 114.86V34.36A15 15 0 0 1 34.5 34.36V114.86 M48.5 114.86V34.36A15 15 0 0 1 78.5 34.36V114.86 M92.5 114.86V34.36A15 15 0 0 1 122.5 34.36V114.86';

/** "Mirogoj" in Montserrat ExtraBold outlines, cap height 100, origin at 0,0. */
const WORDMARK =
  'M116.3 114.9 116 14.9H92.7L58.4 72.6L23.3 14.9H0V114.9H26.1V63.3L51.7 105H64.3L90 61.9L90.3 114.9Z M147.4 28.9C157.4 28.9 164 22.6 164 14C164 5.9 157.4 0 147.4 0C137.4 0 130.9 6.3 130.9 14.4C130.9 22.6 137.4 28.9 147.4 28.9ZM133.9 114.9H161V37.4H133.9Z M203.3 46.7V37.4H177.4V114.9H204.6V79.3C204.6 65.7 212.1 60.1 223.1 60.1C225.1 60.1 226.9 60.3 229.3 60.6V36.1C217.9 36.1 208.9 39.7 203.3 46.7Z M277.4 116.1C303 116.1 321.1 99.4 321.1 76C321.1 52.7 303 36.1 277.4 36.1C252.1 36.1 233.7 52.7 233.7 76C233.7 99.4 252.1 116.1 277.4 116.1ZM277.4 94.6C268.3 94.6 261.1 87.9 261.1 76C261.1 64.3 268.3 57.7 277.4 57.7C286.7 57.7 293.7 64.3 293.7 76C293.7 87.9 286.7 94.6 277.4 94.6Z M390 37.4V46.9C384.7 39.6 376.4 36.1 365.7 36.1C345.1 36.1 327.7 50.7 327.7 73.4C327.7 96.3 345.1 110.9 365.7 110.9C375.6 110.9 383.4 107.9 388.7 101.7V104.3C388.7 116.4 382.6 123 368 123C358.9 123 348.3 119.9 341.9 114.7L332 133.7C341.4 140.4 355.6 143.9 370.4 143.9C399.3 143.9 415.9 130 415.9 100.7V37.4ZM372.1 89.3C362.4 89.3 355.1 82.9 355.1 73.4C355.1 64 362.4 57.7 372.1 57.7C381.9 57.7 389 64 389 73.4C389 82.9 381.9 89.3 372.1 89.3Z M471 116.1C496.6 116.1 514.7 99.4 514.7 76C514.7 52.7 496.6 36.1 471 36.1C445.7 36.1 427.3 52.7 427.3 76C427.3 99.4 445.7 116.1 471 116.1ZM471 94.6C461.9 94.6 454.7 87.9 454.7 76C454.7 64.3 461.9 57.7 471 57.7C480.3 57.7 487.3 64.3 487.3 76C487.3 87.9 480.3 94.6 471 94.6Z M540.9 28.9C550.9 28.9 557.4 22.6 557.4 14C557.4 5.9 550.9 0 540.9 0C530.9 0 524.3 6.3 524.3 14.4C524.3 22.6 530.9 28.9 540.9 28.9ZM522.9 143.9C542.9 143.9 554.4 131.7 554.4 112.9V37.4H527.3V112.7C527.3 119.7 524 122.9 519.3 122.9C516.1 122.9 513.1 122 510.9 120.6L504 139.9C508.7 142.6 515.7 143.9 522.9 143.9Z';
---

<a
  href="/"
  class:list={['inline-flex items-center text-klein', className]}
  aria-label="Mirogoj — početna"
>
  {
    showText ? (
      <svg
        class:list={[fullSize[size], 'w-auto shrink-0']}
        viewBox="0 0 730 144"
        fill="none"
        aria-hidden="true"
      >
        <path d={ARCHES} stroke="currentColor" stroke-width="9" stroke-linecap="butt" />
        <g transform="translate(173 0)">
          <path d={WORDMARK} fill="currentColor" />
        </g>
      </svg>
    ) : (
      <svg
        class:list={[markOnlySize[size], 'w-auto shrink-0']}
        viewBox="0 14.86 127 104.5"
        fill="none"
        aria-hidden="true"
      >
        <path d={ARCHES} stroke="currentColor" stroke-width="9" stroke-linecap="butt" />
      </svg>
    )
  }
</a>
