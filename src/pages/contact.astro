---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Contact from '@/components/sections/Contact.astro';

/**
 * Contact form delivery.
 *
 * The form POSTs to /api/contact, which the Worker (worker/index.ts) routes to
 * functions/api/contact.ts to send the mail through Resend. Setting
 * PUBLIC_CONTACT_FORM_ENDPOINT points it at an external provider instead.
 *
 * Under `astro dev` there is no Worker, so /api/contact returns 404; use
 * `npm run preview:worker` to try the form locally.
 */
const formEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT || '/api/contact';
const contactEmail = 'nikola@mirogoj.com';

/**
 * Turnstile site key for the bot check. Public by design; the matching secret
 * is TURNSTILE_SECRET_KEY on the Worker. PUBLIC_TURNSTILE_SITE_KEY overrides it,
 * e.g. with Cloudflare's always-pass test key for local runs.
 */
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '0x4AAAAAAFnA1Tr_Hi69g2ux';

/** A mailto: submission cannot report a result, so banners need a real endpoint. */
const usesEndpoint = Boolean(formEndpoint);

/**
 * Result banners. The page is statically built and cannot read the ?poruka=
 * flag at build time, so all three are rendered hidden and a small script
 * reveals whichever one matches. Without JavaScript no banner appears, but the
 * message is still delivered.
 */
const banners = [
  {
    key: 'ok',
    tone: 'success',
    title: 'Poruka je poslana.',
    body: 'Hvala na poruci — javit ću se u najkraćem roku.',
  },
  {
    key: 'invalid',
    tone: 'error',
    title: 'Poruka nije poslana.',
    body: 'Provjerite ime, ispravnost e-mail adrese i tekst poruke, pa pokušajte ponovno.',
  },
  {
    key: 'captcha',
    tone: 'error',
    title: 'Poruka nije poslana.',
    body: 'Provjera da niste robot nije uspjela. Pričekajte trenutak pa pošaljite ponovno; ako se pojavi okvir za potvrdu, kliknite ga.',
  },
  {
    key: 'error',
    tone: 'error',
    title: 'Poruka nije poslana.',
    body: `Došlo je do tehničke pogreške. Pokušajte ponovno ili pišite izravno na ${contactEmail}.`,
  },
] as const;
---

<BaseLayout
  title="Kontakt"
  description="Imate priču, fotografiju ili ime koje bi trebalo stajati u zapisima o Mirogoju? Javite se."
>
  {
    usesEndpoint && (
      <div class="container max-w-5xl mx-auto px-4 sm:px-6">
        {banners.map((banner) => (
          <div
            data-poruka={banner.key}
            hidden
            role={banner.tone === 'error' ? 'alert' : 'status'}
            class:list={[
              'mt-8 rounded-lg border p-4',
              banner.tone === 'success'
                ? 'border-klein/40 bg-klein/5'
                : 'border-destructive/40 bg-destructive/5',
            ]}
          >
            <p class="font-medium text-foreground">{banner.title}</p>
            <p class="mt-1 text-sm text-muted-foreground leading-relaxed">{banner.body}</p>
          </div>
        ))}
      </div>
    )
  }

  <Contact
    title="Javite se"
    subtitle="Sjećanja na put u školu, fotografije, imena koja bi trebala stajati u zapisima — pošaljite poruku i javit ću se u najkraćem roku."
    email={contactEmail}
    formAction={formEndpoint ?? `mailto:${contactEmail}`}
    formSubject="Nova poruka s web stranice"
    turnstileSiteKey={turnstileSiteKey}
  />
</BaseLayout>

<script>
  /**
   * Reveals the banner matching ?poruka=... after the form handler redirects
   * back, then strips the parameter so a reload shows nothing stale.
   */
  function showContactResult(): void {
    const status = new URLSearchParams(window.location.search).get('poruka');
    if (!status) return;

    const banner = document.querySelector<HTMLElement>(`[data-poruka="${CSS.escape(status)}"]`);
    if (!banner) return;

    banner.removeAttribute('hidden');
    banner.scrollIntoView({ behavior: 'smooth', block: 'center' });

    const url = new URL(window.location.href);
    url.searchParams.delete('poruka');
    window.history.replaceState({}, '', url);
  }

  showContactResult();
  document.addEventListener('astro:after-swap', showContactResult);
</script>
